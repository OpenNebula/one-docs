{
  "name": "OpenNebula documentation",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "init": true,
  "postCreateCommand": "npm ci --include=dev",
  "waitFor": "postStartCommand",
  "postStartCommand": ["bash", ".devcontainer/start-preview.sh"],
  "postAttachCommand": ["bash", ".devcontainer/start-preview.sh"],
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": {
      "label": "Documentation preview",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  }
}
