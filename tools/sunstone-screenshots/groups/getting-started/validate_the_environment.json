{
  "$schema": "../../schemas/manifest.schema.json",
  "version": 1,
  "group": "group.json",
  "defaults": {"viewport": {"width": 1440, "height": 1000}, "locale": "en-US"},
  "hooks": {
    "setup": [
      {"script": "scripts/prepare-theme.sh", "timeout": 30},
      {"script": "../single-node/scripts/prepare-alpine.sh", "timeout": 30},
      {"script": "scripts/prepare-wordpress.sh", "timeout": 30}
    ],
    "teardown": [
      {"script": "scripts/cleanup-wordpress.sh", "timeout": 360},
      {"script": "../single-node/scripts/cleanup-alpine.sh", "timeout": 240},
      {"script": "scripts/restore-theme.sh", "timeout": 30}
    ]
  },
