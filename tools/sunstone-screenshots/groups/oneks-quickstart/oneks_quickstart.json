{
  "$schema": "../../schemas/manifest.schema.json",
  "version": 1,
  "group": "group.json",
  "defaults": {
    "viewport": {
      "width": 1440,
      "height": 1000
    },
    "locale": "en-US"
  },
  "hooks": {
    "setup": [
      {
        "script": "scripts/prepare-oneks.sh",
        "timeout": 420
      },
      {
        "script": "../getting-started/scripts/prepare-theme.sh",
        "timeout": 30
      }
    ],
    "teardown": [
      {
        "command": "if [ -f /root/screenshot-lab/oneks-workflow.py ]; then python3 /root/screenshot-lab/oneks-workflow.py cleanup; elif [ -e /root/screenshot-lab/oneks-workflow.json ]; then echo 'OneKS helper is missing; marker retained.' >&2; exit 1; fi",
        "timeout": 1200
      },
      {
        "script": "../getting-started/scripts/restore-theme.sh",
        "timeout": 30
      }
    ]
  },
  "screenshots": [
    {
      "id": "oneks.quickstart.networks",
      "title": "Public vnet before creating the private network",
      "doc": "content/getting_started/install_opennebula/evaluation/oneks_quickstart.md",
