{
  "setup": [
    {
      "action": "goto",
      "url": "${SUNSTONE_URL}"
    },
    {
      "action": "fill",
      "selector": "input[type='text']",
      "value": "${SUNSTONE_USER}"
    },
    {
      "action": "fill",
      "selector": "input[type='password']",
      "value": "${SUNSTONE_PASSWORD}"
    },
    {
      "action": "click",
      "role": "button",
      "name": "Sign In Now",
      "exact": true
    },
    {
      "action": "waitForSelector",
      "selector": "[data-cy='sidebar-paper']:visible"
    }
  ],
  "themeSteps": {
    "light": [
      {
        "action": "waitTime",
        "timeout": 1000
      }
    ],
    "dark": [
      {
        "action": "waitTime",
        "timeout": 1000
      }
    ]
  },
  "captures": [
    {
      "id": "dashboard",
      "steps": [
        {
          "action": "waitForSelector",
          "selector": "[data-cy='dashboard-panel']:visible"
        },
        {
          "action": "defocus"
        }
      ],
      "screenshot": {
        "selector": "body"
      }
    }
  ],
  "teardown": [
    {
      "action": "press",
      "selector": "body",
      "key": "Escape"
    },
    {
      "action": "click",
      "selector": "[data-cy='sidebar-user-menu']:visible"
    },
    {
      "action": "click",
      "selector": "[data-cy='sidebar-logout-button']:visible"
    },
    {
      "action": "waitForSelector",
      "selector": "input[type='password']"
    }
  ]
}
