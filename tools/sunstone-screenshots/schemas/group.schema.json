{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sunstone screenshot shared-lab group",
  "type": "object",
  "required": ["version", "provision", "manifests"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "provision": {"type": "string", "minLength": 1},
    "manifests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "destroyOnSuccess": {"type": "boolean", "default": false}
  }
}
